+// Benchmark instrumentation (coinselect-benchmark, see patches/README.md). SelectCoinsBnB is the
+// only search here that records neither its node count nor whether it finished, and both are
+// dropped entirely on the paths that return util::Error. These globals observe the existing loop
+// counter; nothing about the search itself changes.
+size_t g_bnb_selections_evaluated{0};
+bool g_bnb_algo_completed{true};
+
+// Benchmark deadline (coinselect-benchmark, see patches/README.md). Both searches here stop on a
+// node count, which is not the same unit as the round count another engine's budget uses. When set,
+// this gives the harness a way to hand both engines the same *wall-clock* budget instead. Default
+// is a zero time_point, meaning no deadline and exactly the unpatched behaviour.
+std::chrono::steady_clock::time_point g_bench_deadline{};
+static bool BenchDeadlineHit(size_t tries)
+{
+    // Polled every 256 nodes: a steady_clock read costs a few times what visiting a node does, so
+    // checking on every node would distort the very thing being measured.
+    if (g_bench_deadline.time_since_epoch().count() == 0 || (tries & 0xff) != 0) return false;
+    return std::chrono::steady_clock::now() >= g_bench_deadline;
+}
